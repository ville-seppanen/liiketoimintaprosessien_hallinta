<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_yksityinen" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Verkkokauppa" name="Verkkokauppa – yksityinen prosessi" processRef="Process_Verkkokauppa" />
    <bpmn:participant id="Asiakas" name="Asiakas" />
    <bpmn:messageFlow id="MessageFlow_1" name="Tilaus" sourceRef="Asiakas" targetRef="Start" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Vahvistus" targetRef="Asiakas" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Ilmoitus" targetRef="Asiakas" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Hylkays" targetRef="Asiakas" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Verkkokauppa" isExecutable="false">
    <bpmn:startEvent id="Start" name="Tilaus saapunut">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_md" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Maksu" name="Tarkista maksu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw" name="Maksu hyväksytty?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Varaa" name="Varaa tuotteet varastosta">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Vahvistus" name="Lähetä tilausvahvistus">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Keraa" name="Kerää ja pakkaa tuotteet">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Ilmoitus" name="Lähetä toimitusilmoitus">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="Tilaus toimitettu">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Hylkays" name="Ilmoita hylätystä maksusta">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End2" name="Tilaus hylätty">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Maksu" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Maksu" targetRef="Gw" />
    <bpmn:sequenceFlow id="Flow_3" name="kyllä" sourceRef="Gw" targetRef="Varaa" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Varaa" targetRef="Vahvistus" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Vahvistus" targetRef="Keraa" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Keraa" targetRef="Ilmoitus" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Ilmoitus" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_8" name="ei" sourceRef="Gw" targetRef="Hylkays" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Hylkays" targetRef="End2" />
  </bpmn:process>
