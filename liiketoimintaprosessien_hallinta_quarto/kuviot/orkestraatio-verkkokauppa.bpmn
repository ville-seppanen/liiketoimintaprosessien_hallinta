<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_orkestraatio" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Asiakas" name="Asiakas" />
    <bpmn:participant id="Verkkokauppa" name="Verkkokauppa (tilausprosessin ohjaus)" processRef="Process_Verkkokauppa" />
    <bpmn:participant id="Maksupalvelu" name="Maksupalvelu" />
    <bpmn:participant id="Varasto" name="Varasto" />
    <bpmn:participant id="Kuljetusliike" name="Kuljetusliike" />
    <bpmn:messageFlow id="MessageFlow_1" name="Tilaus" sourceRef="Asiakas" targetRef="Start" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Veloita" targetRef="Maksupalvelu" />
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Maksupalvelu" targetRef="Veloita" />
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Keraily" targetRef="Varasto" />
    <bpmn:messageFlow id="MessageFlow_5" sourceRef="Varasto" targetRef="Pakkaus" />
    <bpmn:messageFlow id="MessageFlow_6" sourceRef="Kuljetus" targetRef="Kuljetusliike" />
    <bpmn:messageFlow id="MessageFlow_7" sourceRef="Kuljetusliike" targetRef="Kuljetus" />
    <bpmn:messageFlow id="MessageFlow_8" sourceRef="Hylkays" targetRef="Asiakas" />
    <bpmn:messageFlow id="MessageFlow_9" sourceRef="Ilmoitus" targetRef="Asiakas" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Verkkokauppa" isExecutable="false">
    <bpmn:startEvent id="Start" name="Tilaus vastaanotettu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_md" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Veloita" name="Veloita maksu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw" name="Maksu hyväksytty?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Keraily" name="Lähetä keräilypyyntö">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Pakkaus" name="Vastaanota pakkausilmoitus">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Kuljetus" name="Tilaa kuljetus">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Ilmoitus" name="Lähetä toimitusilmoitus">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="Tilaus käsitelty">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Hylkays" name="Ilmoita hylätystä maksusta">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End2" name="Tilaus hylätty">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Veloita" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Veloita" targetRef="Gw" />
    <bpmn:sequenceFlow id="Flow_3" name="kyllä" sourceRef="Gw" targetRef="Keraily" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Keraily" targetRef="Pakkaus" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Pakkaus" targetRef="Kuljetus" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Kuljetus" targetRef="Ilmoitus" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Ilmoitus" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_8" name="ei" sourceRef="Gw" targetRef="Hylkays" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Hylkays" targetRef="End2" />
  </bpmn:process>
